# Copy to .env and fill in real values. NEVER commit .env.
OPENAI_BASE_URL=https://ai-proxy.lab.epam.com/openai/deployments/<deployment-name>
OPENAI_MODEL=<deployment-name>
OPENAI_API_KEY=<your-dial-api-key>

# T11 local authentication. Real values belong only in the ignored .env.
MCP_API_KEY=<your-local-mcp-api-key>
KEYCLOAK_URL=http://127.0.0.1:8089
KEYCLOAK_REALM=mcp-realm
MCP_CLIENT_ID=mcp-client
MCP_REQUIRED_ROLE=mcp-user
MCP_AUDIENCE=mcp-users
KEYCLOAK_ADMIN_USERNAME=t11-admin
KEYCLOAK_ADMIN_PASSWORD=<your-local-keycloak-admin-password>
MCP_ALLOWED_USER_PASSWORD=<your-local-allowed-user-password>
MCP_NO_ROLE_USER_PASSWORD=<your-local-no-role-user-password>

# Optional, only when an exercise requires other vendors
# ANTHROPIC_API_KEY=<your-anthropic-key>
# GEMINI_API_KEY=<your-gemini-key>
# GEMINI_MODEL=<available-gemini-model-id>
