# Ephemeral work area (fork clones, archives, scratch)
workspace/

# Secrets
.env
*.env
.env.*
!.env.example

# OpenSpec archives are moved to workspace/
openspec/changes/archive/*
!openspec/changes/archive/.gitkeep

